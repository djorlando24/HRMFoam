FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1.01e5;

boundaryField
{
    inlet
    {
        type            transonicTotalPressure;
        phi             phiv;
        p0              60e5;
        value           uniform 60e5;
    }
    outlet
    {
        type            transonicTotalPressure;
        phi             phiv;
        p0              1.01e5;
        value           uniform 1.01e5;
    }
    walls
    {
        type            zeroGradient;
    }
    
    wedge_front          
    {
        type            wedge;
    }

    wedge_back          
    {
        type            wedge;
    }
    axis
    {
        type empty;
    }

}


