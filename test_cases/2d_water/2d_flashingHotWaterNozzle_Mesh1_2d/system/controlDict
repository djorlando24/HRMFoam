FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           dictionary;
    object          controlDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application 	HRMFoam25;

startFrom       latestTime;

startTime       0.0;

stopAt          endTime;

endTime         10E-3;

deltaT          1e-7;

maxDeltaT	1e-6;

writeControl    adjustableRunTime;
writeInterval   1e-4;

//writeControl    timeStep;
//writeInterval   10;

purgeWrite      0;

writeFormat     binary;

writePrecision  7;

writeCompression on;

timeFormat      general;

adjustTimeStep  yes;

maxCo           1.2;

timePrecision   6;

runTimeModifiable yes;

// ************************************************************************* //
