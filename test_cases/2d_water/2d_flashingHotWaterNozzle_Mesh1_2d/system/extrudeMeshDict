FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom   patch;
sourceCase      ".";

sourcePatches   (wedge_back);
exposedPatchName wedge_front;

// REQUIRED IN v2412+
flipNormals     true;
mergeFaces      false;

extrudeModel    wedge;

nLayers         1;
expansionRatio  1.0;

sectorCoeffs
{
    axisPt      (0 0 0);
    axis        (1 0 0);  
    angle       5;        
}
